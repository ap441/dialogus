# Database Configuration
# 
# LOCAL (DEFAULT):
# DATABASE_URL=sqlite:///./dialogus.db
#
# SUPABASE (Remote PostgreSQL):
# Get your connection string from: https://supabase.com/projects
# Then replace with: DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
#
DATABASE_URL=sqlite:///./dialogus.db

# API Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OAuth (Optional)
GOOGLE_CLIENT_ID=
